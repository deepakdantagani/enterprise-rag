# Copy to .env (in the repository root) and change what differs on your machine. It is read when
# the settings are read; a variable already set in the environment wins. Unset = the defaults below.

# Embedding model (SLACK-11a). EMBED_PROVIDER is a key of PROVIDERS in pipeline/slack/embedding.py.
# The model, window and dimensions belong together: change them together.
EMBED_PROVIDER=ollama
EMBED_MODEL=qwen3-embedding:0.6b
EMBED_WINDOW=32768
EMBED_DIMENSIONS=1024

# Where the provider listens. Empty = the provider's own default (Ollama: http://localhost:11434).
EMBED_BASE_URL=
